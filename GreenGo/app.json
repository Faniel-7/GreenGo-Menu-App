{
  "expo": {
    "name": "GreenGo",
    "slug": "GreenGo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "greengo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {},
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030303",
          "image": "./assets/images/logo.png",
          "imageWidth": 140
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
