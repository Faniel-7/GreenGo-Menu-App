{
  "expo": {
    "name": "GreenGo",
    "slug": "GreenGo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "greengo",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/greengo-app-icon.png",
    "ios": {
      "icon": "./assets/images/greengo-app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/greengo-app-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.greengo.menu"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030303",
          "image": "./assets/images/logo.png",
          "imageWidth": 140
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a7bcbdc0-acb9-4dac-8860-c6db2abd3ebf"
      }
    }
  }
}
